<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.modernwpf.com/2019"
                    xmlns:local="clr-namespace:ModernWpf.Controls">

    <Style TargetType="{x:Type local:InfoBar}">
        <Setter Property="Background" Value="{DynamicResource InfoBarInformationalBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBarInformationalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InfoBar}">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding ui:ControlHelper.CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Severity icon -->
                            <TextBlock x:Name="IconGlyph"
                                       Grid.Column="0"
                                       Text="&#xE946;"
                                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       FontSize="16"
                                       Foreground="{DynamicResource InfoBarInformationalIconForeground}"
                                       VerticalAlignment="Top"
                                       Margin="0,1,10,0"
                                       SnapsToDevicePixels="True" />

                            <!-- Title + Message -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <TextBlock x:Name="TitleText"
                                           Text="{TemplateBinding Title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="MessageText"
                                           Text="{TemplateBinding Message}"
                                           TextWrapping="Wrap"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Close button -->
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Margin="10,-2,0,0"
                                    Padding="4"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{TemplateBinding Foreground}"
                                    ToolTip="Schließen"
                                    Focusable="True">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Severity: Success -->
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource InfoBarSuccessBackground}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource InfoBarSuccessBorderBrush}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xE73E;" />
                            <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource InfoBarSuccessIconForeground}" />
                        </Trigger>

                        <!-- Severity: Warning -->
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource InfoBarWarningBackground}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource InfoBarWarningBorderBrush}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xE7BA;" />
                            <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource InfoBarWarningIconForeground}" />
                        </Trigger>

                        <!-- Severity: Error -->
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource InfoBarErrorBackground}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource InfoBarErrorBorderBrush}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xE783;" />
                            <Setter TargetName="IconGlyph" Property="Foreground" Value="{DynamicResource InfoBarErrorIconForeground}" />
                        </Trigger>

                        <!-- Hide close button when IsClosable=false -->
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Hide message when empty -->
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Hide title when empty -->
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
